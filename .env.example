# FreelanceOS — environment template
#
# Copy to .env.local and fill in. Values here are NAMES ONLY — never commit real secrets.
#   cp .env.example .env.local
#
# See the README's "Environment variables" section for what each one does.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the app will not start without these
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB connection string
MONGODB_URI=

# NextAuth. Generate the secret with:  openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth. One client serves both sign-in and Gmail sending, so both redirect
# URIs must be registered on it — see the README's "Google Cloud setup".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq. At least one key is required. The pitch and intel routes try them in order
# and fall through to the next on a rate limit or failure.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_FALLBACK=
# Optional. Overrides the hosted Groq model used by /api/pitch, /api/intel and
# /api/outreach/batch. Leave blank to use the default in src/lib/groq.ts.
# List what your key can reach:
#   curl -s https://api.groq.com/openai/v1/models \
#     -H "Authorization: Bearer $GROQ_API_KEY_1" | jq -r '.data[].id'
GROQ_MODEL=

# Encrypts stored Gmail refresh tokens at rest (AES-256-GCM).
# EXACTLY 64 hex characters = 32 bytes. Generate with:  openssl rand -hex 32
# Rotating this orphans every already-connected Gmail account.
TOKEN_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED FOR GMAIL SENDING
# ─────────────────────────────────────────────────────────────────────────────

# Must match a redirect URI registered on the Google OAuth client, byte for byte.
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Where the Gmail callback redirects back to. Defaults to http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — GitHub sign-in. Omit to hide nothing; the button just fails.
# ─────────────────────────────────────────────────────────────────────────────

GITHUB_ID=
GITHUB_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — client discovery.
#
# Discovery degrades rather than failing. APIFY_API_TOKEN or GOOGLE_PLACES_API_KEY
# is what actually finds businesses; everything below enriches them (website, email,
# socials) through a fallback chain. With none set, /discover returns nothing.
# ─────────────────────────────────────────────────────────────────────────────

APIFY_API_TOKEN=
GOOGLE_PLACES_API_KEY=

SERPER_API_KEY=
SERPAPI_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
SCALESERP_KEY=
VALUESERP_KEY=
SERPSTACK_KEY=
SCRAPINGBEE_KEY=
SCRAPINGANT_KEY=
ZENROWS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — n8n. Fired on signup, non-blocking. Unset = silently skipped.
# ─────────────────────────────────────────────────────────────────────────────

N8N_SIGNUP_WEBHOOK_URL=
